# Optional local configuration for running ConFormBench.
# Copy this file to .env for local use, and keep real keys out of release artifacts.

LLM_BACKEND=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=

# Path to the separately downloaded and extracted Zenodo dataset.
CONFORMBENCH_DATA_DIR=

# Retain complete generation prompts/responses for experimental auditability.
CONFORMBENCH_TRACE_MESSAGES=1
